    color: '#2563EB',
    fondo: 'rgba(37,99,235,0.12)',
    grad: 'linear-gradient(135deg,#2563EB,#06B6D4)',
    alpha: 'rgba(37,99,235,0.3)',
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`
  },
