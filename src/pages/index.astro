    fondo: 'rgba(245,158,11,0.12)',
    grad: 'linear-gradient(135deg,#F59E0B,#F97316)',
    alpha: 'rgba(245,158,11,0.3)',
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  },
  {
    nombre: 'Ventas',
    desc: 'Registro diario de ventas, órdenes y cobranza',
    href: '/ventas',
    color: '#EF4444',
    fondo: 'rgba(239,68,68,0.12)',
    grad: 'linear-gradient(135deg,#EF4444,#DC2626)',
    alpha: 'rgba(239,68,68,0.3)',
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>`
  },
  {
    nombre: 'Consolidado',
