    nombre: 'Inventario',
    desc: 'Control de existencias, valuación y stock mínimo',
    href: '/inventario',
    color: '#10B981',
    fondo: 'rgba(16,185,129,0.12)',
    grad: 'linear-gradient(135deg,#10B981,#059669)',
    alpha: 'rgba(16,185,129,0.3)',
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 10-5 10 5v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>`
  },
  {
    nombre: 'Productos',
    desc: 'Catálogo de artículos, margen y costos de importación',
    href: '/productos',
    color: '#6366F1',
    fondo: 'rgba(99,102,241,0.12)',
    grad: 'linear-gradient(135deg,#6366F1,#8B5CF6)',
    alpha: 'rgba(99,102,241,0.3)',
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`
  },
  {
