---
import Sidebar from '../components/Sidebar.astro';
import Header  from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  titulo:       string;
  paginaActual: string;
  descripcion?: string;
}

const {
  titulo,
  paginaActual,
  descripcion = `${titulo} — ImportPro, Sistema de Gestión de Importaciones`
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-tema="oscuro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} — ImportPro</title>

    <!-- Prevenir flash de tema incorrecto -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('importpro-tema') || 'oscuro';
        document.documentElement.setAttribute('data-tema', t);
      })();
    </script>

    <!-- Guard de sesión: redirige a /login si no hay sesión activa -->
    <script is:inline>
      (function() {
        if (sessionStorage.getItem('importpro-sesion') !== 'activa') {
          window.location.replace('/login');
        }
      })();
    </script>
  </head>

  <body>
    <div class="app">
      <!-- Overlay para oscurecer fondo en móviles -->
      <div class="sidebar-overlay" id="sidebar-overlay"></div>
      <Sidebar paginaActual={paginaActual} />
      <div class="contenido-app">
        <Header titulo={titulo} />
        <main class="main-contenido">
          <slot />
        </main>
      </div>
    </div>

    <!-- Script global: toggle tema + sidebar móvil + modal helpers -->
    <script>
      // ── Toggle tema ──────────────────────────────
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest('[data-toggle-tema]');
        if (!btn) return;
        const html = document.documentElement;
        const actual  = html.getAttribute('data-tema');
        const nuevo   = actual === 'oscuro' ? 'claro' : 'oscuro';
        html.setAttribute('data-tema', nuevo);
        localStorage.setItem('importpro-tema', nuevo);
      });

      // ── Sidebar móvil (drawer) ───────────────────
      const sidebar = document.getElementById('sidebar-app');
      const sidebarOverlay = document.getElementById('sidebar-overlay');

      function abrirSidebar() {
        sidebar?.classList.add('abierto');
        sidebarOverlay?.classList.add('activo');
        document.body.style.overflow = 'hidden';
      }

      function cerrarSidebar() {
        sidebar?.classList.remove('abierto');
        sidebarOverlay?.classList.remove('activo');
        document.body.style.overflow = '';
      }

      document.addEventListener('click', (e) => {
        const target = e.target as Element;

        // Botón toggle menú hamburguesa
        if (target.closest('#btn-toggle-sidebar')) {
          const yaAbierto = sidebar?.classList.contains('abierto');
          if (yaAbierto) {
            cerrarSidebar();
          } else {
            abrirSidebar();
          }
          return;
        }

        // Botón cerrar sidebar móvil o clic en el overlay
        if (target.closest('#btn-cerrar-sidebar-movil') || target.id === 'sidebar-overlay') {
          cerrarSidebar();
          return;
        }

        // Al hacer clic en un ítem de navegación en pantallas móviles, cerrar el sidebar
        if (window.innerWidth <= 1024 && target.closest('.nav-item')) {
          cerrarSidebar();
        }
      });

      // ── Modales: apertura/cierre global ─────────
      document.addEventListener('click', (e) => {
        const target = e.target as Element;

        // Abrir modal
        const btnAbrir = target.closest('[data-abrir-modal]') as HTMLElement | null;
        if (btnAbrir) {
          const id = btnAbrir.dataset.abrirModal!;
          document.getElementById(id)?.classList.add('abierto');
          document.body.style.overflow = 'hidden';
          return;
        }

        // Cerrar modal — botón cerrar
        const btnCerrar = target.closest('[data-cerrar-modal]');
        if (btnCerrar) {
          const overlay = (btnCerrar as Element).closest('.modal-overlay');
          overlay?.classList.remove('abierto');
          document.body.style.overflow = '';
          return;
        }

        // Cerrar modal — clic en el overlay
        if (target.classList.contains('modal-overlay')) {
          target.classList.remove('abierto');
          document.body.style.overflow = '';
        }
      });

      // Tecla Escape (cierra modales y sidebar)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          cerrarSidebar();
          document.querySelectorAll('.modal-overlay.abierto').forEach(m => {
            m.classList.remove('abierto');
          });
          document.body.style.overflow = '';
        }
      });
    </script>
  </body>
</html>
