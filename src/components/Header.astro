---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;

const ahora = new Date();
const fecha = ahora.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
---

<header class="header">
  <div class="header-izq">
    <div class="header-titulo">{titulo}</div>
    <div class="header-breadcrumb">ImportPro · {fecha}</div>
  </div>

  <div class="header-der">
    <!-- Notificaciones -->
    <button class="header-btn" title="Notificaciones" id="btn-notif" aria-label="Notificaciones">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </button>

    <!-- Toggle Tema -->
    <button class="header-btn" data-toggle-tema title="Cambiar tema" aria-label="Cambiar tema">
      <!-- Luna (modo oscuro activo) -->
      <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <!-- Sol (modo claro activo) -->
      <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1"  x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22"   x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1"  y1="12" x2="3"  y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78"  x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="header-sep"></div>

    <!-- Avatar usuario -->
    <div class="header-avatar" title="Perfil">AD</div>
  </div>
</header>
