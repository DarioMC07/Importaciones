---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;

const ahora = new Date();
const fecha = ahora.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
---

<header class="header">
  <div class="header-izq">
    <div class="header-titulo">{titulo}</div>
    <div class="header-breadcrumb">ImportPro · {fecha}</div>
  </div>

  <div class="header-der">
    <!-- Notificaciones -->
    <button class="header-btn" title="Notificaciones" id="btn-notif" aria-label="Notificaciones">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </button>

    <!-- Toggle Tema -->
    <button class="header-btn" data-toggle-tema title="Cambiar tema" aria-label="Cambiar tema">
      <!-- Luna (modo oscuro activo) -->
      <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <!-- Sol (modo claro activo) -->
      <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1"  x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22"   x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1"  y1="12" x2="3"  y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78"  x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="header-sep"></div>

    <!-- Avatar usuario con dropdown -->
    <div class="header-usuario-wrap" id="header-usuario-wrap">
      <button class="header-avatar" id="header-avatar-btn" title="Perfil" aria-haspopup="true" aria-expanded="false">
        AD
      </button>

      <div class="header-dropdown" id="header-dropdown" role="menu">
        <div class="dropdown-header-info">
          <div class="dropdown-avatar-sm">AD</div>
          <div>
            <div class="dropdown-nombre">Administrador</div>
            <div class="dropdown-rol">Acceso completo</div>
          </div>
        </div>
        <div class="dropdown-divider"></div>

        <a href="/settings" class="dropdown-item" role="menuitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <span>Settings</span>
        </a>

        <button class="dropdown-item dropdown-item-peligro" id="btn-cerrar-sesion" role="menuitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          <span>Cerrar Sesión</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header-usuario-wrap {
    position: relative;
  }

  /* Avatar como botón clicable */
  .header-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--grad-primario, linear-gradient(135deg,#2563EB,#06B6D4));
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    font-family: inherit;
  }
  .header-avatar:hover,
  .header-avatar[aria-expanded="true"] {
    border-color: var(--primario-claro, #3B82F6);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
    transform: scale(1.05);
  }

  /* Panel dropdown */
  .header-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 220px;
    background: var(--tarjeta, #0F1E38);
    border: 1px solid var(--borde, #1E3A5F);
    border-radius: 14px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
    padding: 8px;
    z-index: 9999;
    opacity: 0;
    transform: translateY(-8px) scale(0.97);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
  }
  .header-dropdown.abierto {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Sección info del usuario */
  .dropdown-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 10px;
  }
  .dropdown-avatar-sm {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--grad-primario, linear-gradient(135deg,#2563EB,#06B6D4));
    color: #fff;
    font-size: 0.73rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dropdown-nombre {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--texto, #F0F4FF);
    line-height: 1.3;
  }
  .dropdown-rol {
    font-size: 0.71rem;
    color: var(--texto-muted, #4A5F8A);
    margin-top: 1px;
  }

  /* Divisor */
  .dropdown-divider {
    height: 1px;
    background: var(--borde, #1E3A5F);
    margin: 4px 2px 6px;
  }

  /* Ítems del menú */
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--texto-secundario, #8B9CC8);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.14s, color 0.14s;
    font-family: inherit;
    text-align: left;
  }
  .dropdown-item svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.8;
  }
  .dropdown-item:hover {
    background: rgba(255,255,255,0.06);
    color: var(--texto, #F0F4FF);
  }

  /* Ítem de cerrar sesión */
  .dropdown-item-peligro {
    color: var(--peligro, #EF4444);
  }
  .dropdown-item-peligro svg {
    opacity: 1;
  }
  .dropdown-item-peligro:hover {
    background: rgba(239,68,68,0.12);
    color: #FF6B6B;
  }

  /* Modo claro */
  [data-tema="claro"] .header-dropdown {
    background: #ffffff;
    border-color: #C7D7F0;
    box-shadow: 0 12px 40px rgba(15,23,42,0.14);
  }
  [data-tema="claro"] .dropdown-nombre {
    color: #0F172A;
  }
  [data-tema="claro"] .dropdown-item:hover {
    background: rgba(37,99,235,0.07);
    color: #0F172A;
  }
</style>

<script>
  const wrap      = document.getElementById('header-usuario-wrap');
  const avatarBtn = document.getElementById('header-avatar-btn');
  const dropdown  = document.getElementById('header-dropdown');
  const cerrarBtn = document.getElementById('btn-cerrar-sesion');

  function abrirDropdown() {
    dropdown?.classList.add('abierto');
    avatarBtn?.setAttribute('aria-expanded', 'true');
  }

  function cerrarDropdown() {
    dropdown?.classList.remove('abierto');
    avatarBtn?.setAttribute('aria-expanded', 'false');
  }

  avatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.contains('abierto') ? cerrarDropdown() : abrirDropdown();
  });

  // Cerrar al hacer clic fuera del wrapper
  document.addEventListener('click', (e) => {
    if (!wrap?.contains(e.target as Node)) {
      cerrarDropdown();
    }
  });

  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarDropdown();
  });

  // Cerrar sesión → limpiar sesión y redirigir a /login
  cerrarBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('importpro-sesion');
    window.location.href = '/login';
  });
</script>
